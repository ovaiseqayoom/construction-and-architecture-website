# ==============================================================================
# Environment Configuration (All variables are OPTIONAL for local development)
# ==============================================================================
# Copy this file to `.env` only when connecting a custom backend.
# Running `npm run dev` or `npm run build` without a `.env` file boots the app
# in zero-config Demo Mode using built-in project, engineering article, service,
# and team showcase data.

# --- Supabase (Optional CMS, Portfolio, Blog & Lead Storage) ------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Public Site Metadata (Optional, defaults to https://example.com) ---------
VITE_SITE_URL=

# --- Custom API & Integrations (Optional) -------------------------------------
VITE_API_URL=
VITE_REVIEWS_WIDGET_URL=
VITE_VERCEL_TOKEN=

# --- Serverless API Functions (api/*.js - Optional for Vercel Deployment) -----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL_ADDRESS=
RESEND_CAREERS_FROM_EMAIL_ADDRESS=
ADMIN_EMAILS=
DEFAULT_CONTACT_EMAIL=
DEFAULT_INQUIRY_EMAIL=
DEFAULT_CAREERS_EMAIL=
DEFAULT_NEWSLETTER_EMAIL=
DEFAULT_WHATSAPP_NUMBER=
RESEND_TEMPLATE_ADMIN_INQUIRY=
RESEND_TEMPLATE_CLIENT_INQUIRY=
RESEND_TEMPLATE_ADMIN_NEWSLETTER=
RESEND_TEMPLATE_NEWSLETTER_WELCOME=
RESEND_TEMPLATE_ADMIN_NEWSLETTER_UNSUB=
RESEND_TEMPLATE_NEWSLETTER_UNSUB=
RESEND_TEMPLATE_ADMIN_CAREER=
RESEND_TEMPLATE_CAREER_CONFIRMATION=
SITE_URL=
