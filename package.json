{
  "name": "construction-and-architecture-website",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source architecture studio and turnkey construction website built with React, Vite, interactive Markdown diagrams/charts, and optional Supabase integration.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js && node scripts/generate-rss.js",
    "build": "vite build && node scripts/prerender-services.js && node scripts/prerender-static-pages.js && node scripts/prerender-projects.js && node scripts/prerender-blogs.js && node scripts/clean-dist-xml.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:rss": "node scripts/generate-rss.js",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "oxlint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^13.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.74.0",
    "marked": "^15.0.7",
    "mermaid": "^12.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "resend": "^6.21.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
